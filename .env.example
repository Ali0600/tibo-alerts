# Local app: copy with `npm run keys -- --write` (never commit .env).
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=/data/tibo.sqlite
REPOSITORY_URL=https://github.com/Ali0600/tibo-alerts
# Launch gates stay false until docs/OPERATIONS.md acceptance checks pass.
ALERTS_ENABLED=false
SOURCE_VERIFIED=false
DELIVERY_VERIFIED=false
EMAIL_ENABLED=false
PUSH_ENABLED=false
# AES-256 key and independent 32+ character credentials; generated by npm run keys.
DATA_KEY=
SCANNER_SECRET=
DELIVERY_SECRET=
BREVO_WEBHOOK_SECRET=
# Operator-owned X session; only the worker needs this. Never paste into an issue.
TWITTER_AUTH_TOKEN=
EXPECTED_SOURCE_ID=
RSSHUB_PATH=.source-reader
EMAIL_PROVIDER=brevo
EMAIL_FROM=
BREVO_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional self-hosted SMTP (TLS required; port 465 or 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Leave blank unless a trusted reverse proxy strips and replaces this header.
TRUSTED_PROXY_IP_HEADER=
# Worker transport only; public links always use APP_ORIGIN.
INTERNAL_API_ORIGIN=
# Private delivery acceptance tests only; disable again before launch.
VERIFICATION_MODE=false
TEST_EMAIL=
