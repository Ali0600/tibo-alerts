{
  "name": "tibo-alerts",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "dev:node": "TIBO_RUNTIME=node node scripts/with-env.mjs vinext dev",
    "build:node": "TIBO_RUNTIME=node vinext build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:mutations": "node scripts/mutation-check.mjs",
    "worker": "node scripts/with-env.mjs tsx worker/run.ts",
    "source:check": "node scripts/with-env.mjs node scripts/source-check.mjs",
    "keys": "node scripts/generate-keys.mjs",
    "verify:bundle": "node scripts/bundle-budget.mjs",
    "verify:source": "node scripts/with-env.mjs node scripts/verify-source.mjs",
    "verify:delivery": "node scripts/with-env.mjs tsx worker/verify-delivery.ts",
    "source:setup": "node scripts/setup-source.mjs",
    "verify:hosted": "node scripts/check-hosted.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "nodemailer": "10.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "shadcn": "4.18.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260907.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "miniflare": "5.20260907.0-alpha",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "wrangler": "4.129.1"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
